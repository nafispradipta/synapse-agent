# ==============================================================================
# Synapse Cognitive Memory Engine - Environment Configuration Template
# ==============================================================================

# Primary SQLite Database Path (defaults to ./data/synapse.db)
SYNAPSE_DB_PATH=./data/synapse.db

# Context Packing Token Budgets (Progressive tiered packing)
SYNAPSE_TOKEN_BUDGET=250
SYNAPSE_L0_BUDGET=40
SYNAPSE_L1_BUDGET=300

# Subconscious Maintenance Lifecycle Sync State
SYNAPSE_SYNC_STATE_PATH=./data/synapse_last_sync.json

# Standard OpenAI-Compatible Provider Settings
# Works out of the box with any standard provider (OpenAI, Ollama, vLLM, LiteLLM, Groq, LM Studio, etc.)
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Leave model empty to let your local engine/gateway use its active default, or specify your model identifier
OPENAI_MODEL=

# (Optional) Dedicated Synapse Overrides
# If you want to route Synapse memory reflection to a different endpoint than your main agent LLM:
# SYNAPSE_BASE_URL=
# SYNAPSE_API_KEY=
# SYNAPSE_MODEL=

# (Optional) Embedding Configuration
# Primary: all-MiniLM-L6-v2 (when sentence-transformers is installed)
# Fallback: Zero-dependency 384-dim subword vectorizer (built-in, no API or packages needed)
# SYNAPSE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# (Optional) Markdown Knowledge Base / Vault Path
# If set, enables automated Map of Content (MOC) index bookkeeping and bidirectional wikilink crawling
# SYNAPSE_VAULT_PATH=./vault
